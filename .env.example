# Development — local Supabase (`supabase start`, then copy the values from `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production — set the hosted project values in the deployment environment, not in this file
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Public site origin used for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CV extraction. Without this key, upload still stores the file and the profile form stays editable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated emails allowed to use admin tools (e.g. Fetch PNet jobs on Matches).
ADMIN_EMAILS=

# Apify job sync (manual admin button only — no scheduled runs). Set ENABLE flags after you confirm permission per source.
APIFY_API_TOKEN=
# When true, candidate Search jobs only filters saved listings (no new Apify runs).
APIFY_JOB_SEARCH_PAUSED=false
APIFY_SYNC_MAX_PER_SOURCE=5
# LinkedIn actor enforces at least 10 jobs per run regardless of this cap.
APIFY_DEFAULT_LOCATION=South Africa
APIFY_DEFAULT_KEYWORD=graduate
APIFY_ENABLE_PNET=false
APIFY_ENABLE_INDEED=false
APIFY_ENABLE_LINKEDIN=false
APIFY_PNET_ACTOR_ID=shahidirfan/pnet-job-scraper
APIFY_INDEED_ACTOR_ID=curious_coder/indeed-scraper
APIFY_LINKEDIN_ACTOR_ID=worldunboxer/rapid-linkedin-scraper
APIFY_PNET_KEYWORD=graduate
APIFY_PNET_LOCATION=South Africa
APIFY_INDEED_COUNTRY=za
APIFY_INDEED_QUERY=graduate
APIFY_INDEED_LOCATION=South Africa
APIFY_LINKEDIN_QUERY=graduate
APIFY_LINKEDIN_LOCATION=South Africa

# Job ingestion (Week 2). SerpAPI powers Google Jobs discovery for South Africa.
SERPAPI_API_KEY=
# Optional comma-separated Greenhouse board tokens (public job board API).
GREENHOUSE_BOARD_TOKENS=
# Cap imported listings per run (default 1000).
INGEST_JOB_CAP=1000
# Bearer token for GET /api/cron/ingest-jobs
INGEST_CRON_SECRET=

# Daily match digest (Week 3). Uses Resend; cron: GET /api/cron/daily-digest
RESEND_API_KEY=
RESEND_FROM_EMAIL=Fieldwork <onboarding@yourdomain.com>
DIGEST_CRON_SECRET=

# Billing (Week 3). Paystack ZAR checkout + webhook at /api/billing/paystack/webhook
PAYSTACK_SECRET_KEY=
# Local only: set to true to show "Dev: activate Pro" on /dashboard/plan
BILLING_DEV_UPGRADE=

# Auto-apply worker. Keep APPLY_LIVE=false until a permitted live workflow is approved.
APPLY_LIVE=false
APPLY_WORKER_SECRET=
